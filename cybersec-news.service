# Systemd service file for Cybersecurity News Dashboard
# This is a TEMPLATE file - the setup script will replace placeholders with actual values
#
# Placeholders that will be replaced during installation:
#   __INSTALL_USER__    - User to run the service as
#   __INSTALL_GROUP__   - Group to run the service as
#   __INSTALL_PATH__    - Installation directory path
#
# Manual Installation (if not using setup.sh):
#   1. Edit this file and replace __INSTALL_USER__, __INSTALL_GROUP__, __INSTALL_PATH__
#   2. sudo cp cybersec-news.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable cybersec-news
#   5. sudo systemctl start cybersec-news
#
# Automated Installation:
#   sudo ./setup.sh --system-service
#
# Management:
#   sudo systemctl status cybersec-news
#   sudo systemctl restart cybersec-news
#   sudo systemctl stop cybersec-news
#   sudo journalctl -u cybersec-news -f

[Unit]
Description=Cybersecurity News Dashboard
Documentation=https://github.com/boscolam/SecurityNewWeb
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__INSTALL_USER__
Group=__INSTALL_GROUP__
WorkingDirectory=__INSTALL_PATH__
Environment="PATH=__INSTALL_PATH__/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=__INSTALL_PATH__/venv/bin/python3 app.py

# Restart behavior
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__INSTALL_PATH__

# Resource limits
LimitNOFILE=65535
MemoryLimit=512M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cybersec-news

[Install]
WantedBy=multi-user.target

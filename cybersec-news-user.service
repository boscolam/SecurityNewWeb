# Systemd USER service file for Cybersecurity News Dashboard
# This is a TEMPLATE file - the setup script will replace placeholders with actual values
#
# Placeholders that will be replaced during installation:
#   __INSTALL_PATH__    - Installation directory path
#
# Note: User services automatically run as the user who owns the service file
#
# Manual Installation (if not using setup.sh):
#   1. Edit this file and replace __INSTALL_PATH__ with your actual path
#   2. mkdir -p ~/.config/systemd/user/
#   3. cp cybersec-news-user.service ~/.config/systemd/user/cybersec-news.service
#   4. systemctl --user daemon-reload
#   5. systemctl --user enable cybersec-news
#   6. systemctl --user start cybersec-news
#   7. sudo loginctl enable-linger $USER  (optional - start on boot)
#
# Automated Installation:
#   ./setup.sh --service
#
# Management:
#   systemctl --user status cybersec-news
#   systemctl --user restart cybersec-news
#   systemctl --user stop cybersec-news
#   journalctl --user -u cybersec-news -f

[Unit]
Description=Cybersecurity News Dashboard (User Service)
Documentation=https://github.com/boscolam/SecurityNewWeb
After=network.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_PATH__
Environment="PATH=__INSTALL_PATH__/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=__INSTALL_PATH__/venv/bin/python3 app.py

# Restart behavior
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cybersec-news

[Install]
WantedBy=default.target
